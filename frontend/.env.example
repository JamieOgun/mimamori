# Base URL of the MimaMori backend API (mimamori.main:app).
# The dashboard reads this to fetch live call scores from GET /calls.
# Copy to .env.local for local dev. Defaults to http://localhost:6060 if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:6060

# Optional phone number prefill for the dashboard demo call controls.
NEXT_PUBLIC_DEMO_TO_NUMBER=+81...
