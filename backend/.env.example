# --- Scoring pipeline (Claude) ---
ANTHROPIC_API_KEY=
AIAND_API_KEY=
AIAND_MODEL=openai/gpt-oss-120b
AIAND_SCORING_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,zai-org/glm-5.2
AIAND_SCORING_MIN_MODELS=2

# --- OpenAI (Realtime API for the call, Whisper for transcription) ---
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=shimmer
REALTIME_TEMPERATURE=0.8

# --- Twilio ---
# The account SID (AC...) is ALWAYS required.
TWILIO_ACCOUNT_SID=AC...
# Option A: classic auth
TWILIO_AUTH_TOKEN=
# Option B: API key (SK...) + secret (used together with TWILIO_ACCOUNT_SID above)
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=
# The Twilio number calls are placed FROM, in E.164 format.
PHONE_NUMBER_FROM=+81...
# Allowlist of destination numbers the service may call (E.164, comma-separated).
ALLOWED_DESTINATIONS=+81...

# --- Networking ---
# Your public ngrok domain, no protocol (e.g. abcd-1-2-3-4.ngrok-free.app).
DOMAIN=
PORT=6060

# --- Caregiver escalation email ---
# Defaults escalate High-risk calls or scores below 65.
ESCALATION_ENABLED=true
ESCALATION_SCORE_BELOW=65
ESCALATION_RISK_LEVELS=High
CAREGIVER_EMAIL=jamieogundiran@gmail.com
EMAIL_FROM=
DASHBOARD_BASE_URL=http://localhost:3000

# SMTP settings. For Gmail, use smtp.gmail.com with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
